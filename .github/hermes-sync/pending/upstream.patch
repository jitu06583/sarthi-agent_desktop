+        accept a timeout kwarg.  This guards against re-introducing
+        pool.join(timeout=10), which raises TypeError on CPython.
+        """
+        import inspect
+        import multiprocessing.pool
+
+        sig = inspect.signature(multiprocessing.pool.Pool.join)
