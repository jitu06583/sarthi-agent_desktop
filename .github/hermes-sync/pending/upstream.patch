+    """Remove and return task_ids of tasks pending longer than timeout."""
+    import threading
+    global _pending_lock
+    if _pending_lock is None:
+        _pending_lock = threading.Lock()
+    now = time.time()
+    cleared = []
+    with _pending_lock:
+        for tid in list(_pending_tasks.keys()):
