index 23708eca97298467acf9125dd72f6e42b1b7fd11..8f64f64b76f3b0db07ae1ef05ccde06b8e0c57e1 100644
--- a/agent/codex_responses_adapter.py
+++ b/agent/codex_responses_adapter.py
@@ -14,6 +14,7 @@ import hashlib
 import json
