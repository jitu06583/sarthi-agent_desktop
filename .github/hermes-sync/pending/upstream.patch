+def _hold_write_lock(db_path: Path, held: threading.Event, release: threading.Event):
+    conn = sqlite3.connect(str(db_path), timeout=30)
+    try:
+        conn.execute("BEGIN IMMEDIATE")
+        held.set()
+        release.wait(timeout=30)
+        conn.rollback()
+    finally:
