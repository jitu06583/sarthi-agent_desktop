+        """
+        with self._lock:
+            rec = self._tasks.get(task_id)
+            if not rec:
+                return None
+            fut: Future = Future()
+            if rec["state"] in TERMINAL_STATES:
+                fut.set_result((rec["state"], rec.get("reply", "")))
+            else:
