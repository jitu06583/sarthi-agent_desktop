+        """Pool.join() must NOT be called with a timeout argument —
+        CPython's Pool.join signature is (self), so join(timeout=10)
+        would raise TypeError."""
+        mock_pool = MagicMock()
+        mock_pool.imap_unordered.side_effect = RuntimeError("boom")
