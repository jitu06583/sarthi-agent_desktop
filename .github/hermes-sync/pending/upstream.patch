+    if (!Number.isSafeInteger(count) || count < 0 || count > maxWidth) {
+      throw new Error(`unbounded fast-path repeat: ${count}`)
+    }
+
+    return originalRepeat.call(this, count)
+  })
+  vi.spyOn(Array.prototype, 'fill').mockImplementation(function (
+    this: unknown[],
+    value: unknown,
+    start?: number,
+    end?: number
+  ) {
