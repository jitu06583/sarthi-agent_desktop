+        # (e.g. `Path.home() / ".hermes"`), not an executable reference.
+        # Resolving it walks to the filesystem root and fails the
+        # regular-file check below, hard-blocking innocent .py scripts
+        # (#77131). Skip pure-separator tokens.
+        if executable.strip("/"):
