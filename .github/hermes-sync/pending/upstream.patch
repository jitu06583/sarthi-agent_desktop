+            finally:
+                ss.reset_secret_scope(scope_token)
+
+            assert result["returncode"] == 0
+            assert result["output"] == expected
+            assert "EXPLICIT_TOKEN=" not in (
+                tmp_path / "snapshot.sh"
+            ).read_text(encoding="utf-8")
+    finally:
+        ss.set_multiplex_active(False)
