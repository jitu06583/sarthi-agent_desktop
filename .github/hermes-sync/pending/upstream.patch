+    <>
+      <DropdownMenuSearch
+        aria-label={copy.search}
+        onKeyDown={event => {
+          // Claim arrows and Enter from Radix so DOM focus stays in the input
+          // and Enter commits the highlighted row without a DownArrow first.
+          if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
