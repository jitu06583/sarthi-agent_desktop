+        fact_blob = store._conn.execute(
+            "SELECT hrr_vector FROM facts WHERE fact_id = ?",
+            (fact_id,),
+        ).fetchone()["hrr_vector"]
+        bank_blob = store._conn.execute(
+            "SELECT vector FROM memory_banks WHERE bank_name = ?",
+            ("cat:perf",),
