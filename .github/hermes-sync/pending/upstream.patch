+    assert should_clear_session_stall_notification(
+        timeout_seconds=300,
+        idle_seconds=10,
+        has_pending_inbound=True,
+    )
+    assert not should_clear_session_stall_notification(
+        timeout_seconds=300,
+        idle_seconds=400,
+        has_pending_inbound=True,
+    )
